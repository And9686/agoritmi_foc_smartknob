        <mxCell id="zEE2Ob_PBINF-mcMNOjT-26" value="Handles the motor control logic, applies torque using PID, and tracks the current position. As well as calibrating the motor and creating haptic feedback ticks for full system integration." style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;align=center;fontFamily=NewsGotT;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
