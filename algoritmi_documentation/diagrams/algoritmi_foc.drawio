        </mxCell>
        <mxCell id="zEE2Ob_PBINF-mcMNOjT-28" value="Manages Bluetooth communication, sending the knob’s position and commands (buttons and touchscreeen) to the Android App. From the Android App receives configurations.&lt;div&gt;&lt;i&gt;Currently processes touch interactions with the user.&lt;/i&gt;&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;align=center;fontFamily=NewsGotT;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="423" y="40" width="100" height="210" as="geometry" />
        </mxCell>
        <mxCell id="zEE2Ob_PBINF-mcMNOjT-29" value="Updates the screen with the current knob position/mode selected." style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;align=center;fontFamily=NewsGotT;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="543" y="168" width="100" height="82" as="geometry" />
        </mxCell>
        <mxCell id="zEE2Ob_PBINF-mcMNOjT-30" value="Receives position and command updates from BluetoothTask and displays them on the Android interface (Car&#39;s Central Stack).&lt;div&gt;Also sends back configurations for the knob according to the different menus selected.&lt;/div&gt;&lt;div&gt;Configuration string:&lt;br&gt;&quot;KnobMode MinVal MaxVal CurrentVal ModeLetter&quot;&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;align=center;fontFamily=NewsGotT;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="663" y="10" width="100" height="240" as="geometry" />
        </mxCell>
