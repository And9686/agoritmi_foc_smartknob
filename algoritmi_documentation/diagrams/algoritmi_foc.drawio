        </mxCell>
        <mxCell id="zEE2Ob_PBINF-mcMNOjT-27" value="Acts as a central hub, configuring state of MotorTask and forwarding data to DisplayTask and BluetoothTask." style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;align=center;fontFamily=NewsGotT;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;" parent="1" vertex="1">
